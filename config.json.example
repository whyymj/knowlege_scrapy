{
  "database": {
    "host": "localhost",
    "port": 3308,
    "db": "scrapy_db",
    "user": "root",
    "password": "",
    "charset": "utf8mb4"
  },
  "backend": {
    "host": "0.0.0.0",
    "port": 6000,
    "debug": false,
    "cors_enabled": true
  },
  "frontend": {
    "port": 3000,
    "api_proxy": "http://localhost:6000"
  },
  "scrapy": {
    "download_delay": 1,
    "concurrent_requests": 16,
    "obey_robots_txt": false,
    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36",
    "httpcache_enabled": true,
    "httpcache_expiration_secs": 3600
  },
  "docker": {
    "mysql": {
      "root_password": "root123456",
      "user": "scrapy_user",
      "password": "scrapy_pass",
      "port": 3308
    },
    "backend_port": 6000,
    "frontend_port": 3000
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  },
  "crawlers": {
    "proxy_pool": {
      "enabled": false,
      "proxies": []
    },
    "deduplication": {
      "enabled": true,
      "method": "url",
      "storage": "memory",
      "redis_host": "localhost",
      "redis_port": 6379,
      "redis_db": 0
    },
    "user_agents": [
      "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"
    ],
    "ai_arxiv": {
      "enabled": true,
      "frequency": "6h",
      "base_url": "https://arxiv.org/list/cs.AI/recent",
      "anti_crawl": {
        "user_agent_rotation": true,
        "request_delay": 2.0,
        "random_delay": true,
        "retry_times": 3,
        "timeout": 30,
        "use_proxy": false
      }
    },
    "stock_yahoo_finance": {
      "enabled": true,
      "frequency": "5m",
      "base_url": "https://finance.yahoo.com",
      "anti_crawl": {
        "user_agent_rotation": true,
        "request_delay": 1.0,
        "random_delay": true,
        "retry_times": 3,
        "timeout": 30,
        "use_proxy": false
      }
    }
  },
  "pipeline": {
    "quality_monitor": {
      "min_title_length": 5,
      "max_title_length": 500,
      "min_content_length": 50,
      "max_content_length": 1000000,
      "max_age_days": 365
    },
    "normalizer": {
      "enable_sentiment": true,
      "enable_entity_extraction": true
    }
  },
  "analyzer": {
    "deepseek": {
      "api_key": "",
      "api_url": "https://api.deepseek.com/v1/chat/completions",
      "model": "deepseek-chat",
      "timeout": 30,
      "max_retries": 3,
      "cache_enabled": true,
      "cache_ttl_hours": 24,
      "batch_size": 5,
      "batch_delay": 1.0
    }
  },
  "storage": {
    "mysql": {
      "enabled": true,
      "host": "localhost",
      "port": 3308,
      "database": "scrapy_db",
      "user": "root",
      "password": ""
    },
    "influxdb": {
      "enabled": false,
      "host": "localhost",
      "port": 8086,
      "database": "scrapy_ts",
      "username": "",
      "password": ""
    },
    "redis": {
      "enabled": true,
      "host": "localhost",
      "port": 6379,
      "db": 0,
      "password": "",
      "default_ttl": 3600
    }
  }
}
